# n8n webhook that triggers the Google Calendar + notification workflows
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/booking

# Dedicated n8n reschedule workflow (moves a Google Calendar event).
# Expects {"existing_appointment_id", "new_date", "new_time"} and answers
# {"status": "success", "appointment_id"} or {"status": "conflict"}.
N8N_RESCHEDULE_WEBHOOK_URL=https://your-n8n-host.app.n8n.cloud/webhook/clinic-reschedule

# Shared secret Vapi sends on every tool-call request (x-vapi-secret header).
# Set the same value under "Server Secret" in your Vapi tool config.
VAPI_WEBHOOK_SECRET=change-me

# Reference only: Groq runs the LLM inside Vapi; this backend never calls it.
GROQ_API_KEY=gsk_your-groq-key

# Port uvicorn binds to locally (Render/Railway inject their own)
PORT=8000

# Outbound timeout for n8n calls, in seconds (keep tight: Vapi expects results fast)
N8N_TIMEOUT_SECONDS=5

# Max outbound retries for n8n calls (retried only on timeouts/5xx)
N8N_MAX_RETRIES=1

# Append-only structured decision log (JSON Lines), rendered by GET /dashboard
DECISION_LOG_PATH=data/decision_log.jsonl

# Optional Postgres connection string (Supabase / Neon / Render all export this
# as DATABASE_URL). When set, decision-log entries are stored in an auto-created
# `decision_log` table instead of the JSON-lines file; local dev without a DB
# simply leaves it empty.
DATABASE_URL=postgresql://user:password@host:5432/clinic_voice_agent